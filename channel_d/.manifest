{
  "manifest_version": 3,
  "daemon": "channel_d",
  "cname": "channel",
  "sd_type": "channel",
  "ops": ["ipc"],
  "noop_hooks": ["activate", "attach", "teardown"],
  "facades": ["ingress", "execute", "state"],
  "slots": ["create", "delete", "comm", "stream", "query"],
  "rpc": {
    "unix": "channel.sock",
    "win_pipe": "airy_channel",
    "tcp": "AIRY_PORT_CHANNEL_D",
    "tags": "channel,core",
    "buffer": 65536,
    "pool": { "max_events": 64, "min": 4, "max": 8, "queue": 256 },
    "methods": [
      "ping", "list", "open", "close", "send",
      "health", "health_check", "get_stats"
    ]
  },
  "deps": { "required": [], "optional": [] },
  "modules": [
    { "name": "rpc", "sources": ["channel_rpc.c"] },
    { "name": "service", "sources": ["channel_service.c"] },
    { "name": "book", "sources": ["channel_book.c"] },
    { "name": "io", "sources": ["channel_io.c"] }
  ]
}
