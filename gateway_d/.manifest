{
  "manifest_version": 2,
  "daemon": "gateway_d",
  "cname": "gateway",
  "sd_type": "gateway",
  "codegen": false,
  "facades": ["ingress", "execute", "state", "governance"],
  "slots": ["comm", "route", "authz", "stream", "validate"],
  "rpc": {
    "unix": null,
    "tcp": "AIRY_PORT_GATEWAY_HTTP",
    "ws_tcp": "AIRY_PORT_GATEWAY_WS",
    "tags": "gateway,core",
    "buffer": 1048576,
    "methods": ["ping", "shutdown", "health_check", "get_stats"]
  },
  "deps": { "required": [], "optional": ["tool_d", "llm_d", "sched_d"] },
  "modules": [
    { "name": "service", "sources": ["svc.c"] },
    { "name": "protocol", "sources": ["protocol/gateway_jsonpick.c", "protocol/gateway_mcp_server.c", "protocol/gateway_a2a_handler.c", "protocol/gateway_openai_compat.c", "protocol/gateway_protocol_router.c"] },
    { "name": "bootstrap", "sources": ["bootstrap/gw_boot.c", "bootstrap/gw_cli.c", "bootstrap/gw_acl.c", "bootstrap/gw_mcpclients.c"] }
  ]
}
