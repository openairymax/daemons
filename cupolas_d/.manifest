{
  "manifest_version": 1,
  "daemon": "cupolas_d",
  "cname": "cupolas",
  "sd_type": "cupolas",
  "cupolas": "full",
  "facades": ["ingress", "execute", "governance"],
  "slots": ["authz", "validate", "record"],
  "rpc": {
    "unix": "cupolas.sock",
    "win_pipe": "airy_cupolas",
    "tcp": 8089,
    "tags": "cupolas,security",
    "buffer": 65536,
    "pool": { "max_events": 64, "min": 4, "max": 8, "queue": 256 },
    "methods": [
      "check_permission",
      "sanitize",
      "execute_command",
      "add_rule",
      "audit_flush",
      "health_check",
      "get_stats",
      "vault_store",
      "vault_retrieve",
      "vault_delete",
      "vault_list",
      "vault_rotate",
      "net_add_rule",
      "net_check_access",
      "net_get_stats",
      "entitlements_load",
      "entitlements_check",
      "policy_load",
      "policy_activate",
      "policy_rollback",
      "policy_status"
    ]
  },
  "deps": { "required": [], "optional": [] },
  "modules": [
    { "name": "rpc_core", "sources": ["cupolas_rpc_core.c"] },
    { "name": "rpc_vault", "sources": ["cupolas_rpc_vault.c"] },
    { "name": "rpc_net", "sources": ["cupolas_rpc_net_entitlements.c"] },
    { "name": "rpc_policy", "sources": ["cupolas_rpc_policy.c"] }
  ]
}
