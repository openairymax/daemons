{
  "manifest_version": 2,
  "daemon": "llm_d",
  "cname": "llm",
  "sd_type": "llm",
  "ops": ["ipc", "llm"],
  "facades": ["ingress", "execute", "state"],
  "slots": ["compute", "route", "cache", "config", "stream", "resilience"],
  "rpc": {
    "unix": "llm.sock",
    "win_pipe": "airy_llm",
    "tcp": "AIRY_PORT_LLM_D",
    "tags": "ai,core",
    "buffer": 65536,
    "concurrent": true,
    "pool": { "max_events": 64, "min": 4, "max": 8, "queue": 256 },
    "methods": [
      "complete", "complete_stream", "list_models", "count_tokens",
      "health_check", "get_stats", "embeddings"
    ]
  },
  "deps": { "required": [], "optional": [] },
  "modules": [
    { "name": "rpc", "sources": ["rpc/methods.c", "rpc/dispatch.c"] }
  ]
}
