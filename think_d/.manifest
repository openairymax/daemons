{
  "manifest_version": 4,
  "daemon": "think_d",
  "cname": "think",
  "sd_type": "think",
  "endpoint": "apply",
  "ops": ["ipc", "llm", "tool"],
  "noop_hooks": ["attach", "teardown"],
  "facades": ["ingress", "execute", "governance"],
  "slots": ["compute", "flow", "route", "validate", "discover"],
  "rpc": {
    "unix": "think.sock",
    "win_pipe": "airy_think",
    "tcp": "AIRY_PORT_THINK_D",
    "tags": "think,core",
    "buffer": 1048576,
    "concurrent": true,
    "pool": { "max_events": 16, "min": 2, "max": 4, "queue": 32 },
    "methods": [
      "process", "orchestrate", "get_stats", "health_check",
      "lang_process", "lang_postprocess", "lang_stats", "review"
    ]
  },
  "deps": { "required": ["llm_d"], "optional": [] },
  "modules": [
    { "name": "rpc", "sources": ["rpc/think_rpc.c"] },
    { "name": "lang", "sources": ["lang/lang_svc.c"] },
    { "name": "review", "sources": ["review/review_svc.c"] }
  ]
}
