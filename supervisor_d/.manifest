{
  "manifest_version": 2,
  "daemon": "supervisor_d",
  "cname": "supervisor",
  "sd_type": "supervisor",
  "codegen": false,
  "facades": ["ingress", "execute", "state", "governance"],
  "slots": ["recover", "resilience", "create", "comm"],
  "rpc": {
    "unix": "supervisor.sock",
    "tcp": "AIRY_PORT_SUPERVISOR_D",
    "tags": "supervisor,bootstrap",
    "buffer": 4096,
    "methods": ["supervisor.activate", "supervisor.shutdown", "health_check"]
  },
  "deps": { "required": [], "optional": [] },
  "modules": [
    { "name": "decl", "sources": ["decl/decl.c"] },
    { "name": "proc", "sources": ["proc/proc.c"] },
    { "name": "ctrl", "sources": ["ctrl/ctrl.c"] },
    { "name": "net", "sources": ["net/net.c"] }
  ]
}
