{
  "manifest_version": 3,
  "daemon": "tool_d",
  "cname": "tool",
  "sd_type": "tool",
  "ops": ["ipc", "llm", "tool"],
  "noop_hooks": ["activate", "teardown"],
  "facades": ["ingress", "execute", "state", "governance"],
  "slots": ["create", "delete", "update", "query", "discover", "compute", "isolate", "validate", "authz", "cache"],
  "rpc": {
    "unix": "tool.sock",
    "win_pipe": "airy_tool",
    "tcp": "AIRY_PORT_TOOL_D",
    "tags": "tool,core",
    "buffer": 65536,
    "concurrent": true,
    "pool": { "max_events": 64, "min": 4, "max": 8, "queue": 256 },
    "methods": [
      "register", "list_tools", "get_tool", "execute_tool", "execute",
      "list", "health_check", "get_stats", "pending", "approve"
    ]
  },
  "deps": { "required": [], "optional": [] },
  "modules": [
    { "name": "rpc", "sources": ["rpc/tool_rpc.c"] },
    { "name": "plugin", "sources": ["plugin/plugin_rpc.c"] }
  ]
}
